generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // imports sem ".ts" para o tsc/nest build gerar requires válidos
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum TipoEntidade {
  PRAGA
  DOENCA
  CULTURA
}

enum Papel {
  ADMIN /// mantém regras, dicionário e catálogos
  PRODUTOR
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String /// scrypt, "salHex:hashHex"
  papel     Papel    @default(PRODUTOR)
  createdAt DateTime @default(now())

  laudos               Laudo[]
  avaliacoesExportacao AvaliacaoExportacao[]
  avaliacoesCarbono    AvaliacaoCarbono[]
}

model TermoNer {
  id    Int          @id @default(autoincrement())
  tipo  TipoEntidade
  termo String       @unique
}

model Destino {
  id         String                @id // ex.: "ue"
  nome       String
  nomeEn     String
  regras     RegraExportacao[]
  avaliacoes AvaliacaoExportacao[]
}

model Cultura {
  id         String                @id // ex.: "soja"
  nome       String
  nomeEn     String
  regras     RegraExportacao[]
  avaliacoes AvaliacaoExportacao[]
}

/// Exigências por destino × cultura (ilustrativas).
model RegraExportacao {
  id        Int      @id @default(autoincrement())
  destinoId String
  culturaId String
  maxDias   Int /// idade máxima da inspeção em relação ao embarque
  bloqueios String[] /// pragas/doenças que exigem tratamento antes do embarque
  docs      String[] /// documentos confirmados manualmente pelo produtor
  destino   Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  cultura   Cultura  @relation(fields: [culturaId], references: [id], onDelete: Cascade)

  @@unique([destinoId, culturaId])
}

model Bioma {
  id              String @id // ex.: "cerrado"
  nome            String
  reservaLegalMin Int /// % mínimo de Reserva Legal (Código Florestal)
}

model PraticaCarbono {
  id              String @id // ex.: "ilpf"
  nome            String
  /// Fator ILUSTRATIVO de remoção/redução em tCO2e por hectare por ano.
  fatorTco2eHaAno Float
}

model Laudo {
  id        String   @id @default(uuid())
  titulo    String? /// nome do arquivo enviado ou da propriedade
  origem    String   @default("texto") /// "texto" | "txt" | "pdf"
  texto     String
  numero    String?
  entidades Json /// resultado do NER (itens + resumo)
  createdAt DateTime @default(now())
  /// Nulo só em laudos anteriores ao login; o seed os entrega ao administrador.
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  avaliacoes AvaliacaoExportacao[]

  @@index([usuarioId, createdAt])
}

/// Avaliação de exportação salva pelo produtor (aparece no histórico e no relatório).
model AvaliacaoExportacao {
  id              String   @id @default(uuid())
  usuarioId       String
  laudoId         String
  destinoId       String
  culturaId       String
  embarque        String? /// YYYY-MM-DD
  docsConfirmados String[]
  resultado       Json /// retrato no momento em que foi salva, em PT e EN: { pt, en }
  createdAt       DateTime @default(now())
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  laudo           Laudo    @relation(fields: [laudoId], references: [id], onDelete: Cascade)
  destino         Destino  @relation(fields: [destinoId], references: [id], onDelete: Restrict)
  cultura         Cultura  @relation(fields: [culturaId], references: [id], onDelete: Restrict)

  @@index([usuarioId, createdAt])
}

/// Avaliação de elegibilidade a créditos de carbono salva pelo produtor.
model AvaliacaoCarbono {
  id        String   @id @default(uuid())
  usuarioId String
  nome      String /// nome da propriedade
  dados     Json /// formulário enviado (PropriedadeDto)
  resultado Json /// checklist, score e estimativa no momento em que foi salva
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt])
}
