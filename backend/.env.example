DATABASE_URL="postgresql://agroready:agroready@localhost:5432/agroready?schema=public"
PORT=3000

# Assinatura dos tokens de login. Gere um valor próprio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
